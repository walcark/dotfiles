[".local/bin/glow"]
    type = "archive-file"
    url = "https://github.com/charmbracelet/glow/releases/download/v{{ .versions.glow }}/glow_{{ .versions.glow }}_Linux_x86_64.tar.gz"
    path = "glow_{{ .versions.glow }}_Linux_x86_64/glow"
    executable = true

[".config/kitty/themes/kovidgoyal-kitty-themes"]
    type = "git-repo"
    url = "https://github.com/kovidgoyal/kitty-themes.git"
    refreshPeriod = "168h"

[".config/kitty/themes/dexpota-kitty-themes"]
    type = "git-repo"
    url = "https://github.com/dexpota/kitty-themes.git"
    refreshPeriod = "168h"

# agentrc: versioned config for coding agents, deployed by the hook
# .chezmoiscripts/run_after_deploy-agentrc.sh.tmpl (scripts/install.py).
# NOTE: requires the walcark/agentrc remote to be pushed first, otherwise
# `chezmoi apply` fails when cloning this external.
[".local/share/agentrc"]
    type = "git-repo"
    url = "git@github.com:walcark/agentrc.git"
    refreshPeriod = "168h"
