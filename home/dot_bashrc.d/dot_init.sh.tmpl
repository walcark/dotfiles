#!/usr/bin/env bash

# Machine profile — baked in by chezmoi at apply time
MACHINE_DISTRO="{{ .machine.distro }}"

# Generic utilities (info/warn/error) — fallback if lib not deployed yet
if [[ -f "$HOME/bin/lib/shell.sh" ]]; then
    source "$HOME/bin/lib/shell.sh"
else
    function info()  { echo -e "\e[32m* ${*}\e[39m"; }
    function warn()  { echo -e "\e[33m* ${*}\e[39m"; }
    function error() { echo -e "\e[31m* ${*}\e[39m"; }
fi

function source_dir() {
    local dir="$1"
    [[ -d "$dir" ]] || return 0
    for f in "$dir"/*.sh; do
        [[ -f "$f" ]] && source "$f"
    done
}

THIS_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &>/dev/null && pwd )"

source_dir "$THIS_DIR/core"

{{ if .features.dev -}}
source_dir "$THIS_DIR/dev"
{{ end -}}

{{ if .features.hpc -}}
source_dir "$THIS_DIR/hpc"
case "$(hostname -s)" in
    trex*) source_dir "$THIS_DIR/hpc/trex" ;;
esac
{{ end -}}
