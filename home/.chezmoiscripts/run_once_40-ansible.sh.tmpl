#!/usr/bin/env bash
set -euo pipefail

{{ if not .features.admin -}}
echo "[chezmoi] Skipping Ansible install (features.admin=false)."
exit 0
{{ end -}}

if command -v ansible-pull &>/dev/null; then
    echo "[chezmoi] Ansible already installed, skipping."
    exit 0
fi

echo "[chezmoi] Installing Ansible via pipx..."

if ! command -v pipx &>/dev/null; then
{{ if eq .machine.distro "ubuntu" -}}
    sudo apt-get install -y pipx
{{ else if eq .machine.distro "arch" -}}
    sudo pacman -S --noconfirm python-pipx
{{ else -}}
    python3 -m pip install --user pipx
{{ end -}}
    export PATH="$HOME/.local/bin:$PATH"
fi

pipx install ansible-core
echo "[chezmoi] Ansible installed."
