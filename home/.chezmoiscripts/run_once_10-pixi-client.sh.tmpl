#!/usr/bin/env bash
set -e

{{ if .machine.isServer -}}
exit 0
{{ end -}}

echo "[chezmoi] Installing Pixi client tools..."

# Tools for all client machines
# Note: KeePassXC is installed via AppImage in run_once_20-install-keepassxc.sh
# Note: glow (charmbracelet markdown renderer) not available on conda-forge
pixi global install fish

{{ if eq .machine.distro "ubuntu" -}}
# Ubuntu-specific tools
# pixi global install ...
{{ end -}}

{{ if eq .machine.distro "arch" -}}
# Arch-specific tools
# pixi global install ...
{{ end -}}

echo "[chezmoi] Client tools installed via Pixi"
