#!/usr/bin/env bash
set -euo pipefail

{{ if .features.dev -}}
echo "[chezmoi] Installing dev tools via Pixi..."
# Add dev-specific pixi tools here as needed
# pixi global install <tool>
echo "[chezmoi] Dev tools ready."
{{ end -}}

{{ if .features.hpc -}}
echo "[chezmoi] Installing HPC tools via Pixi..."
# Add HPC-specific pixi tools here as needed
# pixi global install <tool>
echo "[chezmoi] HPC tools ready."
{{ end -}}

{{ if .features.gnome -}}
echo "[chezmoi] Installing GNOME tools via Pixi..."
# pixi global install <tool>
echo "[chezmoi] GNOME tools ready."
{{ end -}}

{{ if not (or .features.dev .features.hpc .features.gnome .features.gaming .features.drawing .features.proxmox) -}}
echo "[chezmoi] No feature-specific tools to install."
{{ end -}}
