#!/usr/bin/env bash
set -e

{{ if .machine.isClient -}}
exit 0
{{ end -}}

echo "[chezmoi] Installing Pixi server tools..."

# Tools for all server machines
# pixi global install ...

{{ if hasPrefix "trex" .machine.hostname -}}
# Trex-specific tools
# pixi global install ...
{{ end -}}

echo "[chezmoi] Server tools installed via Pixi"
