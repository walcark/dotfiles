#!/usr/bin/env bash
set -euo pipefail

{{ if not .features.admin -}}
echo "[chezmoi] Skipping ansible-pull (features.admin=false)."
exit 0
{{ end -}}

if ! command -v ansible-pull &>/dev/null; then
    echo "[chezmoi] ansible-pull not found, skipping. (run_once_40 may have failed)"
    exit 0
fi

# Build tag list from active features — sysadmin always runs
TAGS="sysadmin"
{{ if .features.dev     -}} TAGS="${TAGS},dev"     {{ end -}}
{{ if .features.hpc     -}} TAGS="${TAGS},hpc"     {{ end -}}
{{ if .features.gnome   -}} TAGS="${TAGS},gnome"   {{ end -}}
{{ if .features.gaming  -}} TAGS="${TAGS},gaming"  {{ end -}}
{{ if .features.drawing -}} TAGS="${TAGS},drawing" {{ end -}}
{{ if .features.proxmox -}} TAGS="${TAGS},proxmox" {{ end -}}

echo "[chezmoi] Running ansible-pull (tags: ${TAGS})..."

ansible-pull \
    --url "https://github.com/walcark/dotfiles.git" \
    --directory "$HOME/.ansible/pull" \
    --inventory "localhost," \
    --connection local \
    --ask-become-pass \
    --tags "$TAGS" \
    ansible/playbook.yml

echo "[chezmoi] Ansible provisioning complete."
