{{- $distro   := promptStringOnce . "machine.distro" "Distro (ubuntu/arch/fedora)"   "ubuntu" -}}
{{- $pixiHome := promptStringOnce . "pixi.home"      "Pixi home dir (vide = ~/.pixi)" "" -}}
{{- $email    := promptStringOnce . "git.email"      "Git email" "kevin.walcarius@gmail.com" -}}
{{- $dev      := promptBoolOnce   . "features.dev"   "Feature: dev (editor, dev tools)"  true -}}
{{- $hpc      := promptBoolOnce   . "features.hpc"   "Feature: hpc (SLURM, cluster)"     false -}}
{{- $admin    := promptBoolOnce   . "features.admin" "Feature: admin (sudo, ansible)"     false -}}

[edit]
    command = "vi"

[data.machine]
    distro   = {{ $distro | quote }}
    hostname = {{ .chezmoi.hostname | quote }}

[data.features]
    dev     = {{ $dev }}
    hpc     = {{ $hpc }}
    admin   = {{ $admin }}
    gnome   = false
    gaming  = false
    drawing = false
    proxmox = false

[data.pixi]
    home = {{ if $pixiHome }}{{ $pixiHome | quote }}{{ else }}{{ joinPath .chezmoi.homeDir ".pixi" | quote }}{{ end }}

[data.git]
    email = {{ $email | quote }}

[data.versions]
    glow       = "2.1.2"
    keepassxc  = "2.7.12"
