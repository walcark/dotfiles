{{- $distro   := promptStringOnce . "machine.distro" "Distro (ubuntu/arch/fedora)"   "ubuntu" -}}
{{- $pixiHome := promptStringOnce . "pixi.home"      "Pixi home dir (vide = ~/.pixi)" "" -}}
{{- $email    := promptStringOnce . "git.email"      "Git email" "kevin.walcarius@gmail.com" -}}
{{- /* Same set, same defaults as ansible/group_vars/all.yml's `layers:` map — this is
   now the actual per-machine source of truth (see home/private_dot_config/dotfiles/ansible.yml.tmpl);
   group_vars/all.yml only supplies the fallback for a machine that predates this prompt. */ -}}
{{- $desktop  := promptBoolOnce   . "layers.desktop" "Layer: desktop (terminal themes)"       true -}}
{{- $gnome    := promptBoolOnce   . "layers.gnome"   "Layer: gnome (Thunderbird, extensions)" false -}}
{{- $gaming   := promptBoolOnce   . "layers.gaming"  "Layer: gaming (Steam, Lutris, Discord)"  true -}}
{{- $drawing  := promptBoolOnce   . "layers.drawing" "Layer: drawing (Krita)"                 false -}}
{{- $hpc      := promptBoolOnce   . "layers.hpc"     "Layer: hpc (SLURM, cluster)"             false -}}
{{- $dev      := promptBoolOnce   . "layers.dev"     "Layer: dev (editor, dev tools)"          true -}}
{{- $homelab  := promptBoolOnce   . "layers.homelab" "Layer: homelab"                          false -}}

[edit]
    command = "vi"

[data.machine]
    distro   = {{ $distro | quote }}
    hostname = {{ .chezmoi.hostname | quote }}

[data.layers]
    desktop = {{ $desktop }}
    gnome   = {{ $gnome }}
    gaming  = {{ $gaming }}
    drawing = {{ $drawing }}
    hpc     = {{ $hpc }}
    dev     = {{ $dev }}
    homelab = {{ $homelab }}

[data.pixi]
    home = {{ if $pixiHome }}{{ $pixiHome | quote }}{{ else }}{{ joinPath .chezmoi.homeDir ".pixi" | quote }}{{ end }}

[data.git]
    email = {{ $email | quote }}

[data.versions]
    glow       = "2.1.2"
    keepassxc  = "2.7.12"
