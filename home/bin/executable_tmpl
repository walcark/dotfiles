#!/usr/bin/env bash
# Description: Manage project templates in ~/submodules/zk/templates

set -euo pipefail

source "$HOME/bin/lib/zk.sh"

TMPL_DIR="$ZK_DIR/templates"

usage() {
    echo "tmpl — manage project templates in ~/submodules/zk/templates"
    echo ""
    echo "Usage: tmpl list                    list available templates"
    echo "       tmpl new <name>              save current directory as a template"
    echo "       tmpl use <name> [<dest>]     apply template to dest (default: .)"
    exit 1
}

cmd="${1:-}"

case "$cmd" in
    list)
        found=0
        while IFS= read -r -d '' d; do
            name=$(basename "$d")
            count=$(find "$d" -type f | wc -l)
            printf "%-30s  %d files\n" "$name" "$count"
            found=1
        done < <(find "$TMPL_DIR" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)
        [ "$found" -eq 1 ] || echo "(no templates yet)"
        ;;

    new)
        [ $# -lt 2 ] && usage
        name="$2"
        dest="$TMPL_DIR/$name"
        [ ! -d "$dest" ] || { error "Template '$name' already exists"; exit 1; }
        mkdir -p "$dest"
        if command -v rsync &>/dev/null; then
            rsync -a \
                --exclude='.git' --exclude='.pixi' --exclude='__pycache__' \
                --exclude='*.pyc' --exclude='.venv' --exclude='node_modules' \
                --exclude='dist' \
                . "$dest/"
        else
            cp -r . "$dest/"
        fi
        zk_push "$dest" "tmpl: add $name"
        echo "Saved current directory as template '$name'."
        ;;

    use)
        [ $# -lt 2 ] && usage
        name="$2"; dest="${3:-.}"
        src="$TMPL_DIR/$name"
        [ -d "$src" ] || { error "Template '$name' not found"; exit 1; }
        [ "$dest" = "." ] || mkdir -p "$dest"
        cp -r "$src/." "$dest/"
        echo "Applied template '$name' to '$dest'."
        ;;

    *) usage ;;
esac
