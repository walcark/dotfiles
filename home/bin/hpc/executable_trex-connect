#!/usr/bin/env bash
# Description: Copy Trex password to clipboard and SSH into trex.cnes.fr
set -euo pipefail

source "$HOME/bin/lib/keepass.sh"
source "$HOME/bin/lib/clipboard.sh"

get_keepass_password "Browser/Pro/TREX" | clipboard_copy
echo "Password for Trex copied to clipboard."
TERM=xterm-256color ssh -X walcark@trex.cnes.fr
