#!/usr/bin/env bash
# Description: Manage code snippets in ~/submodules/zk/snippets

set -euo pipefail

source "$HOME/bin/lib/zk.sh"

SNIP_DIR="$ZK_DIR/snippets"

ext_for_lang() {
    case "$1" in
        python|py)     echo "py"   ;;
        bash|sh)       echo "sh"   ;;
        lua)           echo "lua"  ;;
        rust|rs)       echo "rs"   ;;
        cpp)           echo "cpp"  ;;
        c)             echo "c"    ;;
        javascript|js) echo "js"   ;;
        typescript|ts) echo "ts"   ;;
        toml)          echo "toml" ;;
        yaml|yml)      echo "yaml" ;;
        json)          echo "json" ;;
        *)             echo "$1"   ;;
    esac
}

usage() {
    echo "snip — manage code snippets in ~/submodules/zk/snippets"
    echo ""
    echo "Usage: snip list [--lang <lang>]     list snippets"
    echo "       snip new <lang> <name>        create a new snippet"
    echo "       snip show <lang> <name>       display a snippet"
    echo "       snip edit <lang> <name>       edit a snippet and commit changes"
    echo "       snip copy <lang> <name>       copy a snippet to clipboard"
    exit 1
}

cmd="${1:-}"

case "$cmd" in
    list)
        shift
        filter_lang=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --lang) shift; filter_lang="$1"; shift ;;
                *) echo "Unknown option: $1" >&2; exit 1 ;;
            esac
        done

        found=0
        current_lang=""
        while IFS= read -r -d '' f; do
            lang=$(basename "$(dirname "$f")")
            [ -n "$filter_lang" ] && [ "$lang" != "$filter_lang" ] && continue
            name=$(basename "$f")
            if [ "$lang" != "$current_lang" ]; then
                [ -n "$current_lang" ] && echo
                printf "\033[1m%s\033[0m\n" "$lang"
                current_lang="$lang"
            fi
            printf "  %s\n" "$name"
            found=1
        done < <(find "$SNIP_DIR" -mindepth 2 -maxdepth 2 -type f -print0 2>/dev/null | sort -z)
        [ "$found" -eq 1 ] || echo "(no snippets yet)"
        ;;

    new)
        [ $# -lt 3 ] && usage
        lang="$2"; name="$3"
        ext=$(ext_for_lang "$lang")
        file="$SNIP_DIR/$lang/$name.$ext"
        mkdir -p "$SNIP_DIR/$lang"
        [ ! -f "$file" ] || { error "Snippet '$lang/$name' already exists"; exit 1; }
        touch "$file"
        zk_editor "$file"
        zk_push "$file" "snip: add $lang/$name"
        ;;

    show)
        [ $# -lt 3 ] && usage
        lang="$2"; name="$3"
        file="$SNIP_DIR/$lang/$name.$(ext_for_lang "$lang")"
        [ -f "$file" ] || { error "Snippet '$lang/$name' not found"; exit 1; }
        zk_show "$file" "$lang"
        ;;

    edit)
        [ $# -lt 3 ] && usage
        lang="$2"; name="$3"
        file="$SNIP_DIR/$lang/$name.$(ext_for_lang "$lang")"
        [ -f "$file" ] || { error "Snippet '$lang/$name' not found"; exit 1; }
        zk_editor "$file"
        zk_push "$file" "snip: update $lang/$name"
        ;;

    copy)
        [ $# -lt 3 ] && usage
        lang="$2"; name="$3"
        file="$SNIP_DIR/$lang/$name.$(ext_for_lang "$lang")"
        [ -f "$file" ] || { error "Snippet '$lang/$name' not found"; exit 1; }
        zk_clipboard "$file"
        echo "Copied '$name' to clipboard."
        ;;

    *) usage ;;
esac
