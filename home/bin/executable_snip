#!/usr/bin/env bash
# Description: Manage code snippets in ~/submodules/zk/snippets

SNIP_DIR="$HOME/submodules/zk/snippets"
ZK_DIR="$HOME/submodules/zk"

ext_for_lang() {
    case "$1" in
        python|py)     echo "py"   ;;
        bash|sh)       echo "sh"   ;;
        lua)           echo "lua"  ;;
        rust|rs)       echo "rs"   ;;
        cpp)           echo "cpp"  ;;
        c)             echo "c"    ;;
        javascript|js) echo "js"   ;;
        typescript|ts) echo "ts"   ;;
        toml)          echo "toml" ;;
        yaml|yml)      echo "yaml" ;;
        json)          echo "json" ;;
        *)             echo "$1"   ;;
    esac
}

usage() {
    echo "snip — manage code snippets in ~/submodules/zk/snippets"
    echo ""
    echo "Usage: snip list [--lang <lang>]   list snippets"
    echo "       snip new <lang> <name>       create a new snippet"
    echo "       snip show <lang> <name>      display a snippet"
    echo "       snip copy <lang> <name>      copy a snippet to clipboard"
    exit 1
}

cmd="${1:-}"

case "$cmd" in
    list)
        shift
        filter_lang=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --lang) shift; filter_lang="$1"; shift ;;
                *) echo "Unknown option: $1" >&2; exit 1 ;;
            esac
        done

        found=0
        current_lang=""
        while IFS= read -r -d '' f; do
            lang=$(basename "$(dirname "$f")")
            [ -n "$filter_lang" ] && [ "$lang" != "$filter_lang" ] && continue
            name=$(basename "$f")
            if [ "$lang" != "$current_lang" ]; then
                [ -n "$current_lang" ] && echo
                printf "\033[1m%s\033[0m\n" "$lang"
                current_lang="$lang"
            fi
            printf "  %s\n" "$name"
            found=1
        done < <(find "$SNIP_DIR" -mindepth 2 -maxdepth 2 -type f -print0 2>/dev/null | sort -z)

        [ "$found" -eq 1 ] || echo "(no snippets yet)"
        ;;

    new)
        [ $# -lt 3 ] && usage
        lang="$2"
        name="$3"
        ext=$(ext_for_lang "$lang")
        file="$SNIP_DIR/$lang/$name.$ext"
        mkdir -p "$SNIP_DIR/$lang"
        if [ -f "$file" ]; then
            echo "Error: snippet '$lang/$name' already exists" >&2
            exit 1
        fi
        touch "$file"
        NVIM_APPNAME="astro-nvim" ${VISUAL:-nvim} "$file"
        git -C "$ZK_DIR" add "$file" && git -C "$ZK_DIR" commit -m "snip: add $lang/$name" && git -C "$ZK_DIR" push
        ;;

    show)
        [ $# -lt 3 ] && usage
        lang="$2"
        name="$3"
        ext=$(ext_for_lang "$lang")
        file="$SNIP_DIR/$lang/$name.$ext"
        if [ ! -f "$file" ]; then
            echo "Error: snippet '$lang/$name' not found" >&2
            exit 1
        fi
        if command -v bat &>/dev/null; then
            bat "$file"
        else
            less "$file"
        fi
        ;;

    copy)
        [ $# -lt 3 ] && usage
        lang="$2"
        name="$3"
        ext=$(ext_for_lang "$lang")
        file="$SNIP_DIR/$lang/$name.$ext"
        if [ ! -f "$file" ]; then
            echo "Error: snippet '$lang/$name' not found" >&2
            exit 1
        fi
        if command -v wl-copy &>/dev/null; then
            wl-copy < "$file"
        elif command -v xclip &>/dev/null; then
            xclip -selection clipboard < "$file"
        elif command -v pbcopy &>/dev/null; then
            pbcopy < "$file"
        else
            echo "Error: no clipboard command found (wl-copy, xclip, pbcopy)" >&2
            exit 1
        fi
        echo "Copied '$name' to clipboard."
        ;;

    *)
        usage
        ;;
esac
