#!/usr/bin/env bash
# Description: Backup home folders to restic repository via KeePassXC credentials

source "$HOME/bin/lib/keepass.sh"

export RESTIC_REPOSITORY="$HOME/$(get_keepass_username "Restic")"
export RESTIC_PASSWORD="$(get_keepass_password "Restic")"

echo $RESTIC_PASSWORD

restic backup \
    "$HOME/dev/" \
    "$HOME/bin/" \
    "$HOME/library/" \
    "$HOME/submodules/zk/" \
    "$HOME/docs/" \
    --exclude-file "$HOME/.config/restic/exclude.txt" \
    --tag backup


