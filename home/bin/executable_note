#!/usr/bin/env bash
# Description: Manage personal notes in ~/submodules/zk/notes

set -euo pipefail

source "$HOME/bin/lib/zk.sh"

NOTE_DIR="$ZK_DIR/notes"

usage() {
    echo "note — manage personal notes in ~/submodules/zk/notes"
    echo ""
    echo "Usage: note list [--tags <t1,t2>]   list notes, optionally filtered by tags"
    echo "       note show <name>              display a note"
    echo "       note new <name>               create and open a new note"
    echo "       note edit <name>              edit a note and commit changes"
    echo "       note del <name>               delete a note"
    echo "       note tags                     list all tags in use"
    exit 1
}

cmd="${1:-}"

case "$cmd" in
    list)
        filter_tags=""
        shift
        while [ $# -gt 0 ]; do
            case "$1" in
                --tags) shift; filter_tags="$1"; shift ;;
                *) echo "Unknown option: $1" >&2; exit 1 ;;
            esac
        done

        if [ -z "$(find "$NOTE_DIR" -maxdepth 1 -name '*.md' 2>/dev/null | head -1)" ]; then
            echo "(no notes yet)"; exit 0
        fi

        found=0
        while IFS= read -r -d '' f; do
            [ -n "$filter_tags" ] && ! zk_match_tags "$f" "$filter_tags" && continue
            name=$(basename "$f" .md)
            title=$(grep -m1 '^# ' "$f" 2>/dev/null | sed 's/^# //' || echo "$name")
            tags=$(grep -m1 '^Tags:' "$f" 2>/dev/null | sed 's/^Tags: *//' || true)
            [ -n "$tags" ] \
                && printf "%-30s  %-35s  [%s]\n" "$name" "$title" "$tags" \
                || printf "%-30s  %s\n" "$name" "$title"
            found=1
        done < <(find "$NOTE_DIR" -maxdepth 1 -name '*.md' -print0 | sort -z)
        [ "$found" -eq 1 ] || echo "(no notes found for given tags)"
        ;;

    show)
        [ $# -lt 2 ] && usage
        file="$NOTE_DIR/${2%.md}.md"
        [ -f "$file" ] || { error "Note '${2%.md}' not found"; exit 1; }
        zk_show "$file"
        ;;

    new)
        [ $# -lt 2 ] && usage
        name=$(zk_normalize_name "$2")
        file="$NOTE_DIR/$name.md"
        mkdir -p "$NOTE_DIR"
        [ ! -f "$file" ] || { error "Note '$name' already exists"; exit 1; }
        read -rp "Tags (comma-separated, optional): " tags
        cat > "$file" <<EOF
# $(zk_capitalize_title "$name")

Date: $(date +%Y-%m-%d)
Tags: $tags

## Notes

EOF
        zk_editor "$file"
        zk_push "$file" "note: add $name"
        ;;

    edit)
        [ $# -lt 2 ] && usage
        name="${2%.md}"
        file="$NOTE_DIR/$name.md"
        [ -f "$file" ] || { error "Note '$name' not found"; exit 1; }
        zk_editor "$file"
        zk_push "$file" "note: update $name"
        ;;

    del)
        [ $# -lt 2 ] && usage
        name="${2%.md}"
        file="$NOTE_DIR/$name.md"
        [ -f "$file" ] || { error "Note '$name' not found"; exit 1; }
        read -rp "Delete '$name'? [y/N] " confirm
        [[ "$confirm" =~ ^[Yy]$ ]] || exit 0
        git -C "$ZK_DIR" rm "$file"
        git -C "$ZK_DIR" commit -m "note: delete $name"
        git -C "$ZK_DIR" push
        ;;

    tags)
        [ -d "$NOTE_DIR" ] || { echo "(no notes yet)"; exit 0; }
        zk_list_tags "$NOTE_DIR" || echo "(no tags yet)"
        ;;

    *) usage ;;
esac
