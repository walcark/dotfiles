#!/usr/bin/env bash
# Description: Copy Trex password to clipboard and SSH into trex.cnes.fr
set -euo pipefail

source "$HOME/bin/lib/keepass.sh"

# Copy TREX password to clipboard
clip_keepass_password "Machines/Trex"
sleep 0.2
echo "Password for Trex was copied to clipboard for 15 seconds..."

# Connect to TREX via ssh
TERM=xterm-256color ssh -X walcark@trex.cnes.fr
sleep 15
xclip -selection clipboard /dev/null
