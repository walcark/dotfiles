#!/usr/bin/env bash
# Description: List TODO/FIXME/HACK/NOTE/XXX comments in source files
set -euo pipefail

BOLD=$'\033[1m'
RESET=$'\033[0m'
RED=$'\033[38;5;203m'
YELLOW=$'\033[38;5;221m'
CYAN=$'\033[38;5;116m'
BLUE=$'\033[38;5;111m'
GREEN=$'\033[38;5;114m'
GREY=$'\033[38;5;245m'

ROOT="${1:-.}"
TMPFILE=$(mktemp)
trap 'rm -f "$TMPFILE"' EXIT

EXTS=("*.py" "*.cpp" "*.hpp" "*.cc" "*.hh" "*.h" "*.c" "*.sh" "*.lua")

if command -v rg &>/dev/null; then
    GLOB_ARGS=()
    for ext in "${EXTS[@]}"; do GLOB_ARGS+=(-g "$ext"); done
    rg --no-heading --line-number --color never \
        -e 'TODO|FIXME|HACK|NOTE|XXX' \
        "${GLOB_ARGS[@]}" "$ROOT" 2>/dev/null > "$TMPFILE" || true
else
    INCLUDE_ARGS=()
    for ext in "${EXTS[@]}"; do INCLUDE_ARGS+=(--include="$ext"); done
    grep -rn "${INCLUDE_ARGS[@]}" -E 'TODO|FIXME|HACK|NOTE|XXX' \
        "$ROOT" 2>/dev/null > "$TMPFILE" || true
fi

if [ ! -s "$TMPFILE" ]; then
    printf "${GREEN}No TODOs found in %s.${RESET}\n" "$ROOT"
    exit 0
fi

kw_color() {
    case "$1" in
        FIXME|XXX) printf '%s' "$RED"    ;;
        TODO)      printf '%s' "$YELLOW" ;;
        HACK)      printf '%s' "$CYAN"   ;;
        NOTE)      printf '%s' "$BLUE"   ;;
    esac
}

current_file=""
total=0; c_todo=0; c_fixme=0; c_hack=0; c_note=0; c_xxx=0

while IFS= read -r raw; do
    file="${raw%%:*}"
    rest="${raw#*:}"
    lineno="${rest%%:*}"
    content="${rest#*:}"

    if [ "$file" != "$current_file" ]; then
        [ -n "$current_file" ] && echo
        relfile="${file#"${ROOT%/}"/}"
        pad=$(printf '─%.0s' $(seq 1 $((56 - ${#relfile} < 3 ? 3 : 56 - ${#relfile}))))
        printf "${GREY}── ${RESET}${BOLD}%s ${GREY}%s${RESET}\n" "$relfile" "$pad"
        current_file="$file"
    fi

    kw=""
    for k in FIXME XXX TODO HACK NOTE; do
        [[ "$content" == *"$k"* ]] && { kw="$k"; break; }
    done

    total=$((total + 1))
    case "$kw" in
        TODO)  c_todo=$((c_todo + 1))   ;;
        FIXME) c_fixme=$((c_fixme + 1)) ;;
        HACK)  c_hack=$((c_hack + 1))   ;;
        NOTE)  c_note=$((c_note + 1))   ;;
        XXX)   c_xxx=$((c_xxx + 1))     ;;
    esac

    color=$(kw_color "$kw")
    colored="${content/$kw/${color}${BOLD}${kw}${RESET}}"
    printf "  ${GREY}%4d${RESET}  %b\n" "$lineno" "$colored"

done < "$TMPFILE"

printf "\n${GREY}%s${RESET}\n" "$(printf '─%.0s' $(seq 1 60))"
printf "  ${BOLD}%d match%s${RESET}" "$total" "$([ "$total" -ne 1 ] && echo 'es' || echo '')"
[ "$c_todo"  -gt 0 ] && printf "  ${YELLOW}● TODO %d${RESET}"  "$c_todo"
[ "$c_fixme" -gt 0 ] && printf "  ${RED}● FIXME %d${RESET}"   "$c_fixme"
[ "$c_hack"  -gt 0 ] && printf "  ${CYAN}● HACK %d${RESET}"   "$c_hack"
[ "$c_note"  -gt 0 ] && printf "  ${BLUE}● NOTE %d${RESET}"   "$c_note"
[ "$c_xxx"   -gt 0 ] && printf "  ${RED}● XXX %d${RESET}"     "$c_xxx"
printf "\n"
