#!/usr/bin/env bash
# Description: List executables in ~/bin with their descriptions

bin_dir="$HOME/bin"

if [ ! -d "$bin_dir" ]; then
    echo "Error: $bin_dir does not exist" >&2
    exit 1
fi

max_len=0
while IFS= read -r -d '' f; do
    name=$(basename "$f")
    len=${#name}
    if [ "$len" -gt "$max_len" ]; then max_len=$len; fi
done < <(find "$bin_dir" -maxdepth 1 -type f -executable -print0)

while IFS= read -r -d '' f; do
    name=$(basename "$f")
    desc=$(head -10 "$f" | grep -m1 '^# Description:' | sed 's/^# Description: *//' || true)
    [ -n "$desc" ] || desc="(no description)"
    printf "%-*s  %s\n" "$max_len" "$name" "$desc"
done < <(find "$bin_dir" -maxdepth 1 -type f -executable -print0 | sort -z)
