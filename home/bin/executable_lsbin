#!/usr/bin/env bash
# Description: List executables in ~/bin with their descriptions

bin_dir="$HOME/bin"

if [ ! -d "$bin_dir" ]; then
    echo "Error: $bin_dir does not exist" >&2
    exit 1
fi

scripts=()
binaries=()

while IFS= read -r -d '' f; do
    read -r firstline < "$f" 2>/dev/null || true
    if [[ "$firstline" == '#!'* ]]; then
        scripts+=("$f")
    else
        binaries+=("$f")
    fi
done < <(find "$bin_dir" -not -path "*/lib/*" -type f -executable -print0 | sort -z)

max_len=0
for f in "${scripts[@]}"; do
    name=$(basename "$f")
    len=${#name}
    [ "$len" -gt "$max_len" ] && max_len=$len
done

if [ "${#scripts[@]}" -gt 0 ]; then
    printf "\033[1mScripts\033[0m\n"
    prev_dir=""
    for f in "${scripts[@]}"; do
        dir=$(dirname "$f")
        subdir="${dir#"$bin_dir"}"
        subdir="${subdir#/}"
        if [ -n "$subdir" ] && [ "$dir" != "$prev_dir" ]; then
            printf "\n  \033[2m[%s]\033[0m\n" "$subdir"
            prev_dir="$dir"
        elif [ -z "$subdir" ] && [ "$prev_dir" != "$bin_dir" ] && [ -n "$prev_dir" ]; then
            prev_dir="$bin_dir"
        fi
        name=$(basename "$f")
        desc=$(head -10 "$f" | grep -m1 '^# Description:' | sed 's/^# Description: *//' || true)
        [ -n "$desc" ] || desc="(no description)"
        printf "  %-*s  %s\n" "$max_len" "$name" "$desc"
    done
fi

if [ "${#binaries[@]}" -gt 0 ]; then
    [ "${#scripts[@]}" -gt 0 ] && echo
    printf "\033[1mBinaries\033[0m\n"
    for f in "${binaries[@]}"; do
        printf "  %s\n" "$(basename "$f")"
    done
fi
