#!/usr/bin/env bash
# Description: Manage zettelkasten tutorials in ~/submodules/zk/tutorials

set -euo pipefail

source "$HOME/bin/lib/zk.sh"

TUTO_DIR="$ZK_DIR/tutorials"

usage() {
    echo "tuto — manage zettelkasten tutorials in ~/submodules/zk/tutorials"
    echo ""
    echo "Usage: tuto list [--tags <t1,t2>]   list all tutorials"
    echo "       tuto show <name>              display a tutorial"
    echo "       tuto new <name>               create and open a new tutorial"
    echo "       tuto edit <name>              edit a tutorial and commit changes"
    echo "       tuto del <name>               delete a tutorial"
    exit 1
}

cmd="${1:-}"

case "$cmd" in
    list)
        filter_tags=""
        shift
        while [ $# -gt 0 ]; do
            case "$1" in
                --tags) shift; filter_tags="$1"; shift ;;
                *) echo "Unknown option: $1" >&2; exit 1 ;;
            esac
        done

        if [ -z "$(find "$TUTO_DIR" -maxdepth 1 -name '*.md' 2>/dev/null | head -1)" ]; then
            echo "(no tutorials yet)"; exit 0
        fi

        found=0
        while IFS= read -r -d '' f; do
            [ -n "$filter_tags" ] && ! zk_match_tags "$f" "$filter_tags" && continue
            name=$(basename "$f" .md)
            title=$(grep -m1 '^# ' "$f" 2>/dev/null | sed 's/^# //' || echo "$name")
            tags=$(grep -m1 '^Tags:' "$f" 2>/dev/null | sed 's/^Tags: *//' || true)
            [ -n "$tags" ] \
                && printf "%-30s  %-30s  [%s]\n" "$name" "$title" "$tags" \
                || printf "%-30s  %s\n" "$name" "$title"
            found=1
        done < <(find "$TUTO_DIR" -maxdepth 1 -name '*.md' -print0 | sort -z)
        [ "$found" -eq 1 ] || echo "(no tutorials found)"
        ;;

    show)
        [ $# -lt 2 ] && usage
        file="$TUTO_DIR/${2%.md}.md"
        [ -f "$file" ] || { error "Tutorial '${2%.md}' not found"; exit 1; }
        zk_show "$file"
        ;;

    new)
        [ $# -lt 2 ] && usage
        name=$(zk_normalize_name "$2")
        file="$TUTO_DIR/$name.md"
        mkdir -p "$TUTO_DIR"
        [ ! -f "$file" ] || { error "Tutorial '$name' already exists"; exit 1; }
        read -rp "Tags (comma-separated, optional): " tags
        cat > "$file" <<EOF
# $(zk_capitalize_title "$name")

Date: $(date +%Y-%m-%d)
Tags: $tags

## Tutorial

## Key commands
EOF
        zk_editor "$file"
        zk_push "$file" "tuto: add $name"
        ;;

    edit)
        [ $# -lt 2 ] && usage
        name="${2%.md}"
        file="$TUTO_DIR/$name.md"
        [ -f "$file" ] || { error "Tutorial '$name' not found"; exit 1; }
        zk_editor "$file"
        zk_push "$file" "tuto: update $name"
        ;;

    del)
        [ $# -lt 2 ] && usage
        name="${2%.md}"
        file="$TUTO_DIR/$name.md"
        [ -f "$file" ] || { error "Tutorial '$name' not found"; exit 1; }
        read -rp "Delete '$name'? [y/N] " confirm
        [[ "$confirm" =~ ^[Yy]$ ]] || exit 0
        git -C "$ZK_DIR" rm "$file"
        git -C "$ZK_DIR" commit -m "tuto: delete $name"
        git -C "$ZK_DIR" push
        ;;

    *) usage ;;
esac
